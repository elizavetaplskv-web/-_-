import sqlite3

conn = sqlite3.connect('recipes_full.db')
cursor = conn.cursor()

# Удаляем старые таблицы
cursor.execute('DROP TABLE IF EXISTS recipe_ingredients')
cursor.execute('DROP TABLE IF EXISTS portions')
cursor.execute('DROP TABLE IF EXISTS recipes')
cursor.execute('DROP TABLE IF EXISTS dishes')
cursor.execute('DROP TABLE IF EXISTS users')
cursor.execute('DROP TABLE IF EXISTS search_history')
cursor.execute('DROP TABLE IF EXISTS ingredients')
cursor.execute('DROP TABLE IF EXISTS categories')
cursor.execute('DROP TABLE IF EXISTS dish_types')
cursor.execute('DROP TABLE IF EXISTS cuisines')

# Создаём таблицы
cursor.execute('''
CREATE TABLE categories (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT UNIQUE NOT NULL
)
''')

cursor.execute('''
CREATE TABLE dish_types (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT UNIQUE NOT NULL
)
''')

cursor.execute('''
CREATE TABLE cuisines (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT UNIQUE NOT NULL
)
''')

cursor.execute('''
CREATE TABLE ingredients (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT UNIQUE NOT NULL,
    category_id INTEGER,
    FOREIGN KEY (category_id) REFERENCES categories(id)
)
''')

cursor.execute('''
CREATE TABLE dishes (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    dish_type_id INTEGER,
    cuisine_id INTEGER,
    prep_time_minutes INTEGER,
    description TEXT,
    FOREIGN KEY (dish_type_id) REFERENCES dish_types(id),
    FOREIGN KEY (cuisine_id) REFERENCES cuisines(id)
)
''')

cursor.execute('''
CREATE TABLE recipes (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    dish_id INTEGER UNIQUE NOT NULL,
    instructions TEXT NOT NULL,
    min_servings INTEGER DEFAULT 1,
    max_servings INTEGER DEFAULT 4,
    FOREIGN KEY (dish_id) REFERENCES dishes(id) ON DELETE CASCADE
)
''')

cursor.execute('''
CREATE TABLE portions (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    recipe_id INTEGER NOT NULL,
    portion_size INTEGER DEFAULT 100,
    calories INTEGER,
    protein REAL,
    fats REAL,
    carbs REAL,
    FOREIGN KEY (recipe_id) REFERENCES recipes(id) ON DELETE CASCADE
)
''')

cursor.execute('''
CREATE TABLE recipe_ingredients (
    recipe_id INTEGER NOT NULL,
    ingredient_id INTEGER NOT NULL,
    quantity REAL,
    unit TEXT,
    PRIMARY KEY (recipe_id, ingredient_id),
    FOREIGN KEY (recipe_id) REFERENCES recipes(id) ON DELETE CASCADE,
    FOREIGN KEY (ingredient_id) REFERENCES ingredients(id) ON DELETE CASCADE
)
''')

cursor.execute('''
CREATE TABLE users (
    user_id INTEGER PRIMARY KEY,
    first_name TEXT,
    last_name TEXT,
    registered_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    last_active DATETIME,
    total_searches INTEGER DEFAULT 0,
    total_recipe_views INTEGER DEFAULT 0
)
''')

cursor.execute('''
CREATE TABLE search_history (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id INTEGER NOT NULL,
    search_time DATETIME DEFAULT CURRENT_TIMESTAMP,
    query TEXT,
    results_count INTEGER,
    selected_recipe_id INTEGER,
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE CASCADE
)
''')

