def get_ingredient_id(ingredient_name):
    cursor.execute('SELECT id FROM ingredients WHERE LOWER(name) = LOWER(?)', (ingredient_name.strip(),))
    result = cursor.fetchone()
    return result[0] if result else None

def find_recipes(user_products_str):
    products = [p.strip().lower() for p in user_products_str.split(',') if p.strip()]
    
    user_ingredient_ids = []
    for product in products:
        ing_id = get_ingredient_id(product)
        if ing_id:
            user_ingredient_ids.append(ing_id)
    
    if not user_ingredient_ids:
        return []
    
    user_set = set(user_ingredient_ids)
    
    cursor.execute('''
        SELECT DISTINCT r.id, d.name, r.instructions, 
               p.calories, p.protein, p.fats, p.carbs, p.portion_size,
               d.prep_time_minutes, dt.name
        FROM recipes r
        JOIN dishes d ON r.dish_id = d.id
        JOIN portions p ON p.recipe_id = r.id
        JOIN dish_types dt ON d.dish_type_id = dt.id
    ''')
    
    all_recipes = cursor.fetchall()
    found = []
    
    for recipe in all_recipes:
        recipe_id = recipe[0]
        cursor.execute('SELECT ingredient_id FROM recipe_ingredients WHERE recipe_id = ?', (recipe_id,))
        recipe_ingredients = [row[0] for row in cursor.fetchall()]
        
        if set(recipe_ingredients).issubset(user_set):
            found.append(recipe)
    
    return found

def format_recipe(recipe, num, total):
    recipe_id, name, instructions, calories, protein, fats, carbs, portion_size, prep_time, dish_type = recipe
    
    cursor.execute('''
        SELECT i.name, ri.quantity, ri.unit 
        FROM recipe_ingredients ri
        JOIN ingredients i ON ri.ingredient_id = i.id
        WHERE ri.recipe_id = ?
    ''', (recipe_id,))
    ingredients_list = cursor.fetchall()
    
    ingredients_text = "\n".join([f"   • {ing[0]}: {ing[1]} {ing[2]}" for ing in ingredients_list])
    
    return f"""🍽 {name.upper()} ({num}/{total})

⏱️ Время: {prep_time} мин | 📋 {dish_type}

📝 ИНГРЕДИЕНТЫ:
{ingredients_text}

👨‍🍳 ПРИГОТОВЛЕНИЕ:
{instructions}

📊 КБЖУ (на {portion_size} г):
   🔥 {calories} ккал | 🥩 {protein} г | 🧈 {fats} г | 🍚 {carbs} г

✅ Всё уже есть дома!"""

