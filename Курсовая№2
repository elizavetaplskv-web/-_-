@app.route('/add_book', methods=['GET', 'POST'])
@login_required
def add_book():
    genres = Genre.query.all()

    if request.method == 'POST':
        title = request.form.get('title', '').strip()
        year = request.form.get('year')
        isbn = request.form.get('isbn', '').strip()
        location = request.form.get('location', '').strip()
        genre_id = request.form.get('genre_id')

        errors = []
        if not title:
            errors.append('Название книги обязательно.')
        if not genre_id:
            errors.append('Выберите жанр.')

        if errors:
            return render_template('add_book.html', errors=errors, genres=genres,
                                   title=title, year=year, isbn=isbn, location=location)

        pub_type = PublicationType.query.first()
        publisher = Publisher.query.first()
        if not pub_type or not publisher:
            return render_template('add_book.html', genres=genres,
                                   errors=['Справочники не заполнены. Обратитесь к администратору.'])

        new_book = Book(
            title=title,
            year=int(year) if year else None,
            isbn=isbn if isbn else None,
            location=location if location else 'Не указано',
            genre_id=int(genre_id),
            type_id=pub_type.id,
            publisher_id=publisher.id
        )
        db.session.add(new_book)
        db.session.commit()
        flash('Книга добавлена!', 'success')
        return redirect(url_for('index'))

    return render_template('add_book.html', genres=genres)

