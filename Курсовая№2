# ---------- Декоратор: только для админа ----------
def admin_required(f):
    @wraps(f)
    @login_required
    def decorated(*args, **kwargs):
        if current_user.role != 'admin':
            flash('Доступ только для администратора.', 'error')
            return redirect(url_for('index'))
        return f(*args, **kwargs)
    return decorated

# ---------- Главная страница: каталог + поиск + фильтр ----------
@app.route('/')
def index():
    search = request.args.get('search', '').strip()
    genre_id = request.args.get('genre', '')

    query = Book.query

    if search:
        query = query.filter(Book.title.ilike(f'%{search}%'))

    if genre_id:
        query = query.filter(Book.genre_id == int(genre_id))

    books = query.all()
    genres = Genre.query.all()

    return render_template('index.html', books=books, genres=genres,
                           search=search, selected_genre=genre_id)

# ---------- Регистрация ----------
@app.route('/register', methods=['GET', 'POST'])
def register():
    if request.method == 'POST':
        username = request.form.get('username', '').strip()
        password = request.form.get('password', '')
        password2 = request.form.get('password2', '')

        errors = []
        if not username:
            errors.append('Введите имя пользователя.')
        if len(password) < 4:
            errors.append('Пароль должен содержать минимум 4 символа.')
        if password != password2:
            errors.append('Пароли не совпадают.')
        if User.query.filter_by(username=username).first():
            errors.append('Такое имя пользователя уже занято.')

        if errors:
            return render_template('register.html', errors=errors, username=username)

        user = User(username=username, role='reader')
        user.set_password(password)
        db.session.add(user)
        db.session.commit()
        flash('Регистрация успешна! Теперь войдите.', 'success')
        return redirect(url_for('login'))

    return render_template('register.html')

# ---------- Вход ----------
@app.route('/login', methods=['GET', 'POST'])
def login():
    if request.method == 'POST':
        username = request.form.get('username', '').strip()
        password = request.form.get('password', '')

        user = User.query.filter_by(username=username).first()
        if user and user.check_password(password):
            login_user(user)
            flash('Вы вошли в систему.', 'success')
            return redirect(url_for('index'))
        else:
            return render_template('login.html', error='Неверное имя пользователя или пароль.')

    return render_template('login.html')

