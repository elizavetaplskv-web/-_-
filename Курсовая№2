from flask_sqlalchemy import SQLAlchemy
from flask_login import UserMixin
from werkzeug.security import generate_password_hash, check_password_hash

db = SQLAlchemy()

# Справочник: Жанр
class Genre(db.Model):
    __tablename__ = 'genres'
    id = db.Column(db.Integer, primary_key=True)
    name = db.Column(db.String(100), nullable=False, unique=True)
    description = db.Column(db.String(255))

# Справочник: Тип издания
class PublicationType(db.Model):
    __tablename__ = 'publication_types'
    id = db.Column(db.Integer, primary_key=True)
    name = db.Column(db.String(50), nullable=False, unique=True)

# Справочник: Статус экземпляра
class CopyStatus(db.Model):
    __tablename__ = 'copy_statuses'
    id = db.Column(db.Integer, primary_key=True)
    name = db.Column(db.String(50), nullable=False, unique=True)

# Справочник: Издательство
class Publisher(db.Model):
    __tablename__ = 'publishers'
    id = db.Column(db.Integer, primary_key=True)
    name = db.Column(db.String(150), nullable=False, unique=True)
    city = db.Column(db.String(100))
    founded_year = db.Column(db.Integer)

# Справочник: Автор
class Author(db.Model):
    __tablename__ = 'authors'
    id = db.Column(db.Integer, primary_key=True)
    last_name = db.Column(db.String(100), nullable=False)
    first_name = db.Column(db.String(100), nullable=False)
    middle_name = db.Column(db.String(100))
    birth_year = db.Column(db.Integer)
    country = db.Column(db.String(100))

# Промежуточная таблица Книга-Автор (M:N)
book_author = db.Table('book_author',
    db.Column('book_id', db.Integer, db.ForeignKey('books.id'), primary_key=True),
    db.Column('author_id', db.Integer, db.ForeignKey('authors.id'), primary_key=True)
)

# Сущность: Книга
class Book(db.Model):
    __tablename__ = 'books'
    id = db.Column(db.Integer, primary_key=True)
    title = db.Column(db.String(255), nullable=False)
    isbn = db.Column(db.String(20), unique=True)
    year = db.Column(db.Integer)
    annotation = db.Column(db.Text)
    language = db.Column(db.String(50), default='Русский')
    location = db.Column(db.String(200), default='Не указано')  # место хранения
    publisher_id = db.Column(db.Integer, db.ForeignKey('publishers.id'), nullable=False)
    genre_id = db.Column(db.Integer, db.ForeignKey('genres.id'), nullable=False)
    type_id = db.Column(db.Integer, db.ForeignKey('publication_types.id'), nullable=False)

    publisher = db.relationship('Publisher')
    genre = db.relationship('Genre')
    pub_type = db.relationship('PublicationType')
    authors = db.relationship('Author', secondary=book_author, backref='books')

# Сущность: Местоположение (оставим для будущего)
class Location(db.Model):
    __tablename__ = 'locations'
    id = db.Column(db.Integer, primary_key=True)
    room = db.Column(db.String(50), nullable=False)
    shelf = db.Column(db.String(50))
    section = db.Column(db.String(50))

# Сущность: Экземпляр книги (оставим для будущего)
class BookCopy(db.Model):
    __tablename__ = 'book_copies'
    id = db.Column(db.Integer, primary_key=True)
    book_id = db.Column(db.Integer, db.ForeignKey('books.id'), nullable=False)
    location_id = db.Column(db.Integer, db.ForeignKey('locations.id'))
    status_id = db.Column(db.Integer, db.ForeignKey('copy_statuses.id'), nullable=False, default=1)
    file_path = db.Column(db.String(500))

    book = db.relationship('Book')
    location = db.relationship('Location')
    status = db.relationship('CopyStatus')

# Сущность: Читатель (оставим для будущего)
class Reader(db.Model):
    __tablename__ = 'readers'
    id = db.Column(db.Integer, primary_key=True)
    last_name = db.Column(db.String(100), nullable=False)
    first_name = db.Column(db.String(100), nullable=False)
    phone = db.Column(db.String(20))
    email = db.Column(db.String(100), unique=True)

# Сущность: Выдача (оставим для будущего)
class Loan(db.Model):
    __tablename__ = 'loans'
    id = db.Column(db.Integer, primary_key=True)
    copy_id = db.Column(db.Integer, db.ForeignKey('book_copies.id'), nullable=False)
    reader_id = db.Column(db.Integer, db.ForeignKey('readers.id'), nullable=False)
    issue_date = db.Column(db.Date, nullable=False)
    due_date = db.Column(db.Date, nullable=False)
    return_date = db.Column(db.Date)
    status_id = db.Column(db.Integer, db.ForeignKey('copy_statuses.id'), nullable=False, default=2)

    copy = db.relationship('BookCopy')
    reader = db.relationship('Reader')
    status = db.relationship('CopyStatus')

# НОВОЕ: Пользователь (для входа на сайт)
class User(UserMixin, db.Model):
    __tablename__ = 'users'
    id = db.Column(db.Integer, primary_key=True)
    username = db.Column(db.String(50), unique=True, nullable=False)
    password_hash = db.Column(db.String(255), nullable=False)
    role = db.Column(db.String(20), nullable=False, default='reader')  # 'reader' или 'admin'

    def set_password(self, password):
        self.password_hash = generate_password_hash(password)

    def check_password(self, password):
        return check_password_hash(self.password_hash, password)

