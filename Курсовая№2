# ---------- Оформление выдачи ----------
@app.route('/loans/new', methods=['GET', 'POST'])
@admin_required
def new_loan():
    copies = BookCopy.query.filter_by(status_id=1).all()
    readers = Reader.query.order_by(Reader.last_name).all()

    if request.method == 'POST':
        copy_id = request.form.get('copy_id')
        reader_id = request.form.get('reader_id')
        days = request.form.get('days', '14')

        errors = []
        if not copy_id:
            errors.append('Выберите экземпляр.')
        if not reader_id:
            errors.append('Выберите читателя.')
        try:
            days = int(days)
            if days < 1 or days > 90:
                errors.append('Срок должен быть от 1 до 90 дней.')
        except ValueError:
            errors.append('Срок должен быть числом.')

        if errors:
            return render_template('new_loan.html', errors=errors,
                                   copies=copies, readers=readers)

        copy = BookCopy.query.get(int(copy_id))
        if copy.status_id != 1:
            return render_template('new_loan.html', copies=copies, readers=readers,
                                   errors=['Этот экземпляр уже выдан.'])

        issue = date.today()
        due = issue + timedelta(days=days)

        loan = Loan(
            copy_id=copy.id,
            reader_id=int(reader_id),
            issue_date=issue,
            due_date=due,
            status_id=2
        )
        copy.status_id = 2
        db.session.add(loan)
        db.session.commit()
        flash('Книга выдана читателю.', 'success')
        return redirect(url_for('loans_list'))

    return render_template('new_loan.html', copies=copies, readers=readers)

