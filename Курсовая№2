@app.route('/loans/<int:loan_id>/return', methods=['POST'])
@admin_required
def return_loan(loan_id):
    loan = Loan.query.get_or_404(loan_id)
    if loan.return_date:
        flash('Книга уже возвращена.', 'error')
        return redirect(url_for('loans_list'))

    loan.return_date = date.today()
    loan.status_id = 1
    loan.copy.status_id = 1
    db.session.commit()
    flash('Книга возвращена.', 'success')
    return redirect(url_for('loans_list'))

# ---------- Экспорт книг в CSV ----------
@app.route('/admin/export/books.csv')
@admin_required
def export_books_csv():
    output = StringIO()
    output.write('\ufeff')
    writer = csv.writer(output, delimiter=';')
    writer.writerow(['ID', 'Название', 'Год', 'ISBN', 'Жанр', 'Место хранения', 'Авторы'])

    for b in Book.query.order_by(Book.title).all():
        authors = ', '.join(f'{a.last_name} {a.first_name}' for a in b.authors) if b.authors else ''
        writer.writerow([
            b.id,
            b.title,
            b.year or '',
            b.isbn or '',
            b.genre.name if b.genre else '',
            b.location or '',
            authors
        ])

    output.seek(0)
    return Response(
        output.read(),
        mimetype='text/csv; charset=utf-8',
        headers={'Content-Disposition': 'attachment; filename=books.csv'}
    )

